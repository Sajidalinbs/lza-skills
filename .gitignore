# ── macOS / editor junk ──────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Excel lock files ─────────────────────────────────────────────────
~$*

# ── CUSTOMER DATA — never commit (real emails / account IDs / CIDRs) ──
